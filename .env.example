# Set the canonical HTTPS domain before deployment. Local development uses localhost.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional verified public contact and social links. Empty values render no fake links.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/betarog/
NEXT_PUBLIC_BRAND_GITHUB_URL=
NEXT_PUBLIC_BRAND_LINKEDIN_URL=
# Personal profiles, shown separately in the founder section only when supplied.
NEXT_PUBLIC_FOUNDER_GITHUB_URL=
NEXT_PUBLIC_FOUNDER_LINKEDIN_URL=

# Email stays disabled until explicitly configured. See README for the delivery test.
CONTACT_ENABLED=false
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Production requires distributed rate limiting, Turnstile, and a private hash secret.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Draft article previews only work in development; never exposed by a production build.
ENABLE_DRAFT_PREVIEWS=false

# Optional Plausible integration, loaded only after explicit visitor opt-in.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
